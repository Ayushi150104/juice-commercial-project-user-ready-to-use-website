# ===== Server =====
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ===== Database =====
MONGODB_URI=mongodb://127.0.0.1:27017/juicedb

# ===== JWT =====
# Generate strong values: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ===== Admin seed account =====
ADMIN_EMAIL=admin@juice.local
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Store Admin

# ===== Payments =====
# This project uses a MOCK gateway. Pressing "Place Order" writes a real
# Payment document (status "paid") with a generated transaction id, but no
# money moves and no third-party keys are needed. Nothing to configure.

# ===== Storefront money rules =====
# Stored on every order, so changing them never rewrites past orders.
CURRENCY=INR
# Flat delivery fee in rupees. 0 = free delivery (cart total == order total).
DELIVERY_FEE=0
# Waive the delivery fee once the subtotal reaches this amount. 0 = never waive.
FREE_DELIVERY_ABOVE=0
# Tax percentage, e.g. 5 for 5% GST. 0 = no tax line.
TAX_PERCENT=0

# ===== Image storage =====
# "local" stores files in /uploads and serves them at /uploads/*
# "cloudinary" uploads to Cloudinary (set the three CLOUDINARY_* vars)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Misc =====
# Set to 1 when deployed behind a reverse proxy (nginx/render/railway)
TRUST_PROXY=0
LOG_LEVEL=info
